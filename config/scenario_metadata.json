{
    "filesystem_scope_expansion": {
        "security_boundary": "filesystem",
        "ground_truth": "SECURITY_RELEVANT",
        "baseline_config": {
            "allowed_roots": [
                "sandbox/workspace"
            ]
        },
        "drift_config": {
            "allowed_roots": [
                "sandbox/workspace",
                "sandbox/private"
            ]
        },
        "configuration_change": "Filesystem access scope expanded from workspace to workspace plus private.",
        "expected_behavior": {
            "baseline": "DENIED",
            "drift": "ALLOWED"
        }
    },

